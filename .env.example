# ==============================================================================
# Pockit API Gateway - Environment Variables Example
# Copy this file to .env and replace placeholder values for your environment.
# ==============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=ares

# Jasypt Master Password (required when using ENC(...) values)
JASYPT_ENCRYPTOR_PASSWORD=replace-with-secure-jasypt-master-key

# CORS & Security Headers
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*
CSP_POLICY=default-src 'none'; frame-ancestors 'none'

# Downstream Microservices URIs
MS_AUTH_USER_URI=http://localhost:8081
MS_ACCOUNTS_URI=http://localhost:8082
MS_TRANSACTIONS_URI=http://localhost:8083
MS_SYNC_URI=http://localhost:8084
MS_ANALYTICS_URI=http://localhost:8085

# TLS (Server-side HTTPS - enabled by default in hermes and zeus)
SERVER_SSL_ENABLED=false
SERVER_SSL_KEYSTORE_PATH=file:/certs/gateway-keystore.p12
SERVER_SSL_KEYSTORE_PASSWORD=ENC(replace-with-encrypted-keystore-password)

# mTLS (Gateway -> Downstream Microservices - enabled by default in hermes and zeus)
APP_MTLS_ENABLED=false
APP_MTLS_KEYSTORE_PATH=file:/certs/gateway-keystore.p12
APP_MTLS_KEYSTORE_PASSWORD=ENC(replace-with-encrypted-keystore-password)
APP_MTLS_TRUSTSTORE_PATH=file:/certs/pockit-truststore.p12
APP_MTLS_TRUSTSTORE_PASSWORD=ENC(replace-with-encrypted-truststore-password)
